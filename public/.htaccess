<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the requested filename/directory exists, serve it directly (for CSS/JS/Images)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Otherwise, send everything else to index.php
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>